# PromptCraft AI - Environment Configuration

# Server Settings
APP_NAME="PromptCraft AI"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# CORS Allowed Origins (Comma separated or * for development)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:5500,http://localhost:8000,chrome-extension://*"

# Default LLM Provider for Optimization Engine: "gemini" | "openai" | "mock"
DEFAULT_OPTIMIZER_PROVIDER="gemini"
DEFAULT_TARGET_PROVIDER="gemini"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API (Optional)
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
